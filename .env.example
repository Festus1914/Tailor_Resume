# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# .env.local is gitignored — never commit real credentials.
# ---------------------------------------------------------------------------

# --- Anthropic (required) --------------------------------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for resume tailoring and job extraction. Optional — defaults to
# claude-sonnet-5, which handles the layered truthfulness constraints in the
# tailoring prompt noticeably better than the smaller tiers.
ANTHROPIC_MODEL=claude-sonnet-5

# --- MongoDB (required) ----------------------------------------------------
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Do NOT put the database name in the URI path — set MONGODB_DB below instead,
# so the same cluster URI can be pointed at a scratch database in development.
MONGODB_URI=

# Database name within the cluster. Optional — defaults to resume_tailor.
MONGODB_DB=resume_tailor

# --- Authentication (required from Phase 3 onward) -------------------------
# Used to derive the session cookie signing/hashing keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates every existing session.
SESSION_SECRET=

# The first account to sign up with this address is automatically promoted to
# an approved administrator. Without it, every new account would sit in
# "pending" with nobody able to approve it. Keep it set to a real address you
# control, and it stays inert after that account exists.
ADMIN_EMAIL=

# --- Node Environment (optional) -------------------------------------------
# Set to 'production' for Vercel deployments
NODE_ENV=development
